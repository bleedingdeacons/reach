# Composer dependencies. A single rule, matching every other plugin in the
# suite. This file previously enumerated 1752 individual vendor paths, which
# is why eight files slipped through and ended up tracked: psr/container's
# source and a regenerated .phpunit.result.cache.
/vendor/

# composer.lock, likewise matching the rest of the suite. Reach and Trumpet
# were the only two plugins tracking theirs; every other one ignores it, so CI
# resolves dependencies from composer.json on each run. Keeping one plugin's
# lock tracked pinned its dev tooling while the other sixteen floated, which is
# the inconsistency this removes.
composer.lock

# Regenerated on every run; an untracked cache file left the working tree
# looking dirty, which was tripping the version-bump "altered" check.
.phpunit.result.cache
/.phpunit.cache/

/build/

# Local coverage reports: `composer test:coverage` writes the HTML report
# here, and CI writes the Clover report under build/. Neither belongs in git.
/tests/coverage/

# JetBrains IDE files
.idea/

# PHPStan
# phpstan.neon (no .dist) is a local override that wins over the committed
# phpstan.neon.dist outright — PHPStan takes the first file it finds and does
# not merge them. Ignored so a personal tweak cannot be committed by accident.
/phpstan.neon
