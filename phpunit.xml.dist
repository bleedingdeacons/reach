<?xml version="1.0" encoding="UTF-8"?>
<!--
    Committed PHPUnit config.

    There was none before, so `vendor/bin/phpunit` printed its help text and
    the suite could only be run by passing the bootstrap file and a path on
    the command line by hand. Nothing in CI ran it at all.

    Schema is 10.5. Coverage include/exclude therefore lives in <source>,
    not the 9.x <coverage> element.

    It read 9.6 until wp_mock was dropped, and said so: the suite was "pinned
    to PHPUnit ^9.6 (with wp_mock 1.1.1)". That pin came from wp_mock's own
    require block, which names "phpunit/phpunit": "^9.6" and has no PHPUnit 10
    branch — and Reach never called wp_mock at all.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.result.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <!--
            There is deliberately no <exclude> here.

            src/Admin used to be excluded, on the grounds that admin screens
            are thin WordPress render/callback glue exercised through wp-admin
            at runtime rather than in unit tests. Amber disproves that — it
            covers its whole src/Admin on this same tooling — and these four
            screens are the personal-data surface of a public finder, so the
            capability gates on them are exactly the code that most wants a
            test. tests/Admin covers them; Integrity did the same first
            (bleedingdeacons/integrity#42).

            Excluding a directory does not just hide it from the report, it
            takes it out of the denominator, so an untested admin layer read as
            a higher percentage than a tested one. Anything added under src/
            from here counts.
        -->
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
